# Raw and interim data are never committed (ARCHITECTURE.md §5.5, §7.1).
# Provenance is recorded in assumptions.md as a finding entry: dataset slug,
# file name, row count and SHA-256. The entrypoint verifies that checksum at
# §7.7 step 2 before anything runs.
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep

# Environment. Reproduction is from requirements.lock.txt at the interpreter
# version pinned in .python-version (§7.5).
.venv/
__pycache__/
*.py[cod]

# macOS
.DS_Store
